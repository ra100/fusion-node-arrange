-- Adds a "Node Arrange" menu to the Fusion Studio menu bar and makes the
-- actions bindable in View > Customize Hotkeys.
{
	Action
	{
		ID = "NodeArrange_Auto",
		Category = "Node Arrange",
		Name = "Arrange Nodes",
		Targets = {
			Composition = {
				Execute = _Lua [=[ target:RunScript("Scripts:Comp/Node Arrange/Arrange Nodes.lua") ]=],
			},
		},
	},
	Action
	{
		ID = "NodeArrange_Routers",
		Category = "Node Arrange",
		Name = "Arrange Nodes with Routers",
		Targets = {
			Composition = {
				Execute = _Lua [=[ target:RunScript("Scripts:Comp/Node Arrange/Arrange Nodes with Routers.lua") ]=],
			},
		},
	},
	Action
	{
		ID = "NodeArrange_Horizontal",
		Category = "Node Arrange",
		Name = "Arrange Nodes Horizontal",
		Targets = {
			Composition = {
				Execute = _Lua [=[ target:RunScript("Scripts:Comp/Node Arrange/Arrange Nodes Horizontal.lua") ]=],
			},
		},
	},
	Action
	{
		ID = "NodeArrange_Vertical",
		Category = "Node Arrange",
		Name = "Arrange Nodes Vertical",
		Targets = {
			Composition = {
				Execute = _Lua [=[ target:RunScript("Scripts:Comp/Node Arrange/Arrange Nodes Vertical.lua") ]=],
			},
		},
	},
	Action
	{
		ID = "NodeArrange_Options",
		Category = "Node Arrange",
		Name = "Arrange Nodes Options...",
		Targets = {
			Composition = {
				Execute = _Lua [=[ target:RunScript("Scripts:Comp/Node Arrange/Arrange Nodes Options.lua") ]=],
			},
		},
	},
	Action
	{
		ID = "NodeArrange_AlignRow",
		Category = "Node Arrange",
		Name = "Align Selection Horizontally",
		Targets = {
			Composition = {
				Execute = _Lua [=[ target:RunScript("Scripts:Comp/Node Arrange/Align Selection Horizontally.lua") ]=],
			},
		},
	},
	Action
	{
		ID = "NodeArrange_AlignColumn",
		Category = "Node Arrange",
		Name = "Align Selection Vertically",
		Targets = {
			Composition = {
				Execute = _Lua [=[ target:RunScript("Scripts:Comp/Node Arrange/Align Selection Vertically.lua") ]=],
			},
		},
	},

	Menus
	{
		Target = "ChildFrame",

		Before "Help"
		{
			Sub "Node Arrange"
			{
				"NodeArrange_Auto{}",
				"NodeArrange_Routers{}",
				"NodeArrange_Options{}",
				"_",
				"NodeArrange_Horizontal{}",
				"NodeArrange_Vertical{}",
				"_",
				"NodeArrange_AlignRow{}",
				"NodeArrange_AlignColumn{}",
			},
		},
	},
}
